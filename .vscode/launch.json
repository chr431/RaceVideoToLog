{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "RaceVideoToLog GUI",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/RaceVideoToLog.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "env": {
                "PYTHONIOENCODING": "utf-8"
            }
        },
        {
            "name": "RaceVideoToLog CLI (test4.mp4)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/RaceVideoToLog.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": [
                "test4.mp4",
                "--roi", "520", "770", "830", "820",
                "--max-speed", "400",
                "--max-accel", "50"
            ],
            "env": {
                "PYTHONIOENCODING": "utf-8"
            }
        }
    ]
}
